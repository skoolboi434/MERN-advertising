{
  "name": "mern-advertising",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d"
  },
  "author": "Travis Davis",
  "license": "MIT",
  "description": "Advertising system built with the MERN Stack",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14"
  }
}
